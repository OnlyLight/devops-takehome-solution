# Scripts are bind-mounted into Linux containers: CRLF would break them ("sh\r: not found").
* text=auto
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.tpl  text eol=lf
*.tf   text eol=lf
*.go   text eol=lf
*.json text eol=lf
*.md   text eol=lf
Dockerfile text eol=lf
*.png  binary
.gitattributes text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
go.mod text eol=lf
go.sum text eol=lf
