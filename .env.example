# Optional overrides. Copy to .env only if you need to change a default. No secrets here.
CLUSTER_NAME=itv
# Host port that maps to the cluster Ingress (curl http://localhost:8080/api/quote)
HOST_PORT=8080
# ArgoCD repo URL; defaults to `git remote get-url origin` of this clone
# REPO_URL=https://github.com/OnlyLight/devops-takehome-solution.git
